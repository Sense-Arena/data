{
  "compilerOptions": {
    // Active consumers: Next.js 15/16 and Vite 8 projects running on Node.js 24.
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": false,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "module": "esnext",
    "outDir": "./dist/.build",
    "declarationDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "types": [],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "declaration": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}
