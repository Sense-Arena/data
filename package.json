{
  "name": "@sensearena/data",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sense-Arena/data.git"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && node --test test/package.test.cjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "rollup": "4.64.12",
    "typescript": "7.0.2"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "source": "src/index.ts",
  "main": "./dist/@sa-data.js",
  "umd:main": "./dist/@sa-data.umd.js",
  "module": "./dist/@sa-data.module.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/@sa-data.modern.mjs",
      "require": "./dist/@sa-data.js",
      "default": "./dist/@sa-data.modern.mjs"
    }
  }
}
